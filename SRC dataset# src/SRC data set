# src/dataset.py
import numpy as np
from torch.utils.data import Dataset

class TimeSeriesDataset(Dataset):
    """
    windows: sliding windows of length L as input, H as target horizon
    data: numpy array shape (T, D)
    """
    def __init__(self, data: np.ndarray, input_len=96, target_len=24, stride=1):
        self.data = data
        self.input_len = input_len
        self.target_len = target_len
        self.stride = stride
        self.indices = self._make_indices()

    def _make_indices(self):
        T = self.data.shape[0]
        idxs = []
        L = self.input_len
        H = self.target_len
        for start in range(0, T - L - H + 1, self.stride):
            idxs.append(start)
        return idxs

    def __len__(self):
        return len(self.indices)

    def __getitem__(self, i):
        s = self.indices[i]
        x = self.data[s:s+self.input_len]        # (L, D)
        y = self.data[s+self.input_len:s+self.input_len+self.target_len]  # (H, D)
        return x.astype('float32'), y.astype('float32')
