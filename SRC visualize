# src/visualize.py
import torch
import numpy as np
import matplotlib.pyplot as plt
import argparse
from pathlib import Path
from src.model import TimeSeriesTransformer
from src.dataset import TimeSeriesDataset

def plot_attention_sample(encodings, out_path):
    # encodings: (L, d_model) or (batch, L, d_model)
    if encodings.ndim == 3:
        enc = encodings[0]
    else:
        enc = encodings
    # compute self-similarity as proxy for attention: dot product between time steps
    sim = enc @ enc.T  # (L, L)
    plt.figure(figsize=(6,5))
    plt.imshow(sim, aspect='auto', origin='lower')
    plt.colorbar()
    plt.title("Encoder self-similarity (proxy for attention)")
    Path(out_path).parent.mkdir(parents=True, exist_ok=True)
    plt.savefig(out_path, dpi=150)
    plt.close()

def main(checkpoint, data, config, out="figs/attention.png"):
    import yaml
    cfg = yaml.safe_load(open(config))
    obj = np.load(data, allow_pickle=True)
    values = obj['values']
    test = values[int(values.shape[0]*0.85):]
    ds = TimeSeriesDataset(test, input_len=cfg['model']['L'], target_len=cfg['model']['H'])
    x,_ = ds[0]
    model = TimeSeriesTransformer(
        d_model=cfg['model']['d_model'],
        nhead=cfg['model']['nhead'],
        num_layers=cfg['model']['num_layers'],
        input_dim=values.shape[1],
        dim_feedforward=cfg['model'].get('dim_feedforward',128),
        target_len=cfg['model']['H']
    )
    model.load_state_dict(torch.load(checkpoint, map_location='cpu')['model_state'])
    model.eval()
    with torch.no_grad():
        inp = torch.from_numpy(x[None].astype('float32'))
        _, enc = model(inp)
        enc = enc.numpy()[0]  # (L, d_model)
    plot_attention_sample(enc, out)
    print("Saved attention proxy figure to", out)

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--checkpoint", required=True)
    parser.add_argument("--data", default="data/preprocessed.npz")
    parser.add_argument("--config", default="configs/default.yaml")
    parser.add_argument("--out", default="figs/attention.png")
    args = parser.parse_args()
    main(args.checkpoint, args.data, args.config, args.out)
