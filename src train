# src/train.py
import torch
import torch.nn as nn
from torch.utils.data import DataLoader
import numpy as np
import argparse
import yaml
from pathlib import Path
from src.dataset import TimeSeriesDataset
from src.model import TimeSeriesTransformer

def load_data(npz_path):
    obj = np.load(npz_path, allow_pickle=True)
    values = obj['values']  # (T, D)
    return values

def train(cfg):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    data = load_data(cfg['data']['path'])
    # simple train/val/test split by time
    T = data.shape[0]
    train_end = int(T * 0.7)
    val_end = int(T * 0.85)
    train = data[:train_end]
    val = data[train_end:val_end]
    test = data[val_end:]

    train_ds = TimeSeriesDataset(train, input_len=cfg['model']['L'], target_len=cfg['model']['H'], stride=cfg['data'].get('stride',1))
    val_ds = TimeSeriesDataset(val, input_len=cfg['model']['L'], target_len=cfg['model']['H'])
    train_loader = DataLoader(train_ds, batch_size=cfg['training']['batch_size'], shuffle=True, num_workers=0)
    val_loader = DataLoader(val_ds, batch_size=cfg['training']['batch_size'], shuffle=False, num_workers=0)

    model = TimeSeriesTransformer(
        d_model=cfg['model']['d_model'],
        nhead=cfg['model']['nhead'],
        num_layers=cfg['model']['num_layers'],
        input_dim=data.shape[1],
        dropout=cfg['model'].get('dropout',0.1),
        dim_feedforward=cfg['model'].get('dim_feedforward',128),
        target_len=cfg['model']['H']
    ).to(device)

    optimizer = torch.optim.AdamW(model.parameters(), lr=cfg['training']['lr'])
    criterion = nn.MSELoss()

    best_val_loss = float('inf')
    Path(cfg['paths']['checkpoint_dir']).mkdir(parents=True, exist_ok=True)

    for epoch in range(1, cfg['training']['epochs']+1):
        model.train()
        train_losses = []
        for x, y in train_loader:
            x = x.to(device); y = y.to(device)
            preds, _ = model(x)
            loss = criterion(preds, y)
            optimizer.zero_grad(); loss.backward(); optimizer.step()
            train_losses.append(loss.item())
        val_loss = evaluate_loss(model, val_loader, device, criterion)
        print(f"Epoch {epoch}: train_loss={np.mean(train_losses):.6f}, val_loss={val_loss:.6f}")
        if val_loss < best_val_loss:
            best_val_loss = val_loss
            torch.save({'model_state': model.state_dict()}, Path(cfg['paths']['checkpoint_dir'])/ 'best.pt')
    print("Training complete.")

def evaluate_loss(model, loader, device, criterion):
    model.eval()
    losses = []
    with torch.no_grad():
        for x, y in loader:
            x = x.to(device); y = y.to(device)
            preds, _ = model(x)
            losses.append(criterion(preds, y).item())
    return float(np.mean(losses))

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default="configs/default.yaml")
    args = parser.parse_args()
    cfg = yaml.safe_load(open(args.config))
    train(cfg)
